<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Discover Header Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_courses"
            android:textColor="?attr/colorOnSurface"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Explore 500+ Virtual University video lecture courses"
            android:textColor="?attr/colorOutline"
            android:textSize="13sp" />

        <!-- Search Bar with Pill Shape -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_search_input"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="6dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_search"
                app:tint="?attr/colorPrimary" />

            <EditText
                android:id="@+id/et_header_search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="@string/search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:paddingHorizontal="10dp"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOutline"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/btn_header_clear_search"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="7dp"
                android:src="@drawable/ic_close"
                android:visibility="gone"
                app:tint="?attr/colorOutline" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_header_search_action"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:backgroundTint="?attr/colorPrimary"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/search_action"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="18dp" />
        </LinearLayout>

        <!-- Quick Trending Tags Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/trending_label"
                android:textColor="?attr/colorOutline"
                android:textSize="12sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Trending Chip 1 -->
                    <TextView
                        android:id="@+id/chip_trend_cs101"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_trending_chip"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="5dp"
                        android:text="CS101"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="12sp" />

                    <!-- Trending Chip 2 -->
                    <TextView
                        android:id="@+id/chip_trend_cs201"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_trending_chip"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="5dp"
                        android:text="CS201"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="12sp" />

                    <!-- Trending Chip 3 -->
                    <TextView
                        android:id="@+id/chip_trend_python"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_trending_chip"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="5dp"
                        android:text="Python"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="12sp" />

                    <!-- Trending Chip 4 -->
                    <TextView
                        android:id="@+id/chip_trend_data"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_trending_chip"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="5dp"
                        android:text="Data Science"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="12sp" />

                    <!-- Trending Chip 5 -->
                    <TextView
                        android:id="@+id/chip_trend_calculus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_trending_chip"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="5dp"
                        android:text="Calculus"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="12sp" />

                    <!-- Trending Chip 6 -->
                    <TextView
                        android:id="@+id/chip_trend_accounting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_trending_chip"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="5dp"
                        android:text="Accounting"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="12sp" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>
    </LinearLayout>

    <!-- Popular Subjects Section (2-Row Horizontal Scrolling Grid as in GIF) -->
    <LinearLayout
        android:id="@+id/section_popular_subjects"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingBottom="6dp"
            android:text="@string/filter_by_popular_subjects"
            android:textColor="?attr/colorOnSurface"
            android:textSize="18sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_popular_subjects"
            android:layout_width="match_parent"
            android:layout_height="148dp"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:paddingHorizontal="10dp"
            tools:itemCount="6"
            tools:listitem="@layout/item_subject_card" />
    </LinearLayout>

    <!-- Explore Courses Section Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tv_catalog_section_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/explore_courses_and_programs"
            android:textColor="?attr/colorOnSurface"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_reset_subject_filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:padding="6dp"
            android:text="Show All"
            android:textColor="?attr/colorPrimary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

</LinearLayout>
