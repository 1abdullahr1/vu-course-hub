<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <!-- High-Performance Direct YouTube Player Container -->
    <FrameLayout
        android:id="@+id/player_container"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="#000000">

        <WebView
            android:id="@+id/player_web_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Instant Video Thumbnail to eliminate startup black screen -->
        <ImageView
            android:id="@+id/iv_player_thumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="Video Thumbnail" />

        <!-- Loading indicator on top of thumbnail -->
        <ProgressBar
            android:id="@+id/pb_player_loader"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminateTint="#FFFFFF" />
    </FrameLayout>

    <!-- Up Next & Lecture List (60fps Recycled RecyclerView with ConcatAdapter) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_player_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        tools:listitem="@layout/item_lecture_row" />

</LinearLayout>
