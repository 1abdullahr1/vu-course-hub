<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/player_sheet_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_sliding_player"
    android:elevation="12dp">

    <!-- EXPANDED PLAYER VIEW -->
    <LinearLayout
        android:id="@+id/expanded_player_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/colorBackground"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical">

        <!-- Top Drag Header & Collapse Toolbar -->
        <LinearLayout
            android:id="@+id/player_top_bar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <ImageButton
                android:id="@+id/btn_collapse_player"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Collapse Player"
                android:padding="10dp"
                android:src="@drawable/ic_arrow_down"
                app:tint="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/tv_expanded_course_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:paddingStart="4dp"
                android:paddingEnd="12dp"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp"
                tools:text="CS101 - Introduction to Computing" />

            <!-- Optional Drag Handle Indicator in center -->
            <View
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/rounded_ripple"
                android:backgroundTint="?attr/colorOutline" />
        </LinearLayout>

        <!-- Video Player Container (16:9 Aspect Ratio) -->
        <FrameLayout
            android:id="@+id/player_container"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:background="#000000">

            <WebView
                android:id="@+id/player_web_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Instant Cached Thumbnail Overlay -->
            <ImageView
                android:id="@+id/iv_player_thumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Video Thumbnail"
                android:scaleType="centerCrop" />

            <!-- Centered Loading Spinner -->
            <ProgressBar
                android:id="@+id/pb_player_loader"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:indeterminateTint="#FFFFFF" />
        </FrameLayout>

        <!-- Lecture Queue / Up Next Recycled List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_player_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="32dp"
            tools:listitem="@layout/item_lecture_row" />
    </LinearLayout>

    <!-- MINI PLAYER BAR (Docked at the top of the sheet, height 64dp) -->
    <LinearLayout
        android:id="@+id/mini_player_bar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="?attr/colorSurface"
        android:clickable="true"
        android:elevation="6dp"
        android:focusable="true"
        android:orientation="vertical">

        <!-- Thin Accent Progress Line at the very top -->
        <ProgressBar
            android:id="@+id/pb_mini_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2.5dp"
            android:max="1000"
            android:progress="0"
            android:progressBackgroundTint="?attr/colorSurfaceVariant"
            android:progressTint="@color/primary" />

        <!-- Mini Player Content Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <!-- Rounded Thumbnail -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_mini_thumbnail"
                android:layout_width="54dp"
                android:layout_height="40dp"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Small"
                tools:src="@drawable/playlist_placeholder" />

            <!-- Title & Subtitle -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_mini_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="13sp"
                    tools:text="Lecture 01 - Introduction" />

                <TextView
                    android:id="@+id/tv_mini_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="?attr/colorSecondary"
                    android:textSize="11sp"
                    tools:text="CS101 • Virtual University" />
            </LinearLayout>

            <!-- Play / Pause Action Button -->
            <ImageButton
                android:id="@+id/btn_mini_play_pause"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Play or Pause"
                android:padding="8dp"
                android:src="@drawable/ic_pause"
                app:tint="?attr/colorOnSurface" />

            <!-- Close Action Button -->
            <ImageButton
                android:id="@+id/btn_mini_close"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close Player"
                android:padding="9dp"
                android:src="@drawable/ic_close"
                app:tint="?attr/colorOnSurface" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
