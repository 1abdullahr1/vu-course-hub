<resources>
    <style name="Theme.VULectureHub" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary Brand Colors -->
        <item name="colorPrimary">@color/dark_primary</item>
        <item name="colorOnPrimary">@color/dark_onPrimary</item>
        <item name="colorPrimaryContainer">@color/dark_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/dark_onPrimaryContainer</item>

        <!-- Background & Surface -->
        <item name="android:colorBackground">@color/dark_background</item>
        <item name="colorOnBackground">@color/dark_onBackground</item>
        <item name="colorSurface">@color/dark_surface</item>
        <item name="colorOnSurface">@color/dark_onSurface</item>
        <item name="colorSurfaceVariant">@color/dark_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/dark_onSurfaceVariant</item>

        <!-- Status & Navigation Bars -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="ThemeOverlay.VULectureHub.BottomNav" parent="">
        <item name="colorSecondaryContainer">@color/nav_active_indicator</item>
        <item name="colorOnSecondaryContainer">@color/dark_primary</item>
    </style>
</resources>
